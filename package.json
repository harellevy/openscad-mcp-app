{
  "name": "openscad-mcp",
  "version": "0.2.3",
  "description": "MCP server for iterating on OpenSCAD models inline in chat: render previews, check code, export meshes.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "openscad-mcp": "dist/index.js",
    "openscad-mcp-doctor": "dist/doctor.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "doctor": "npm run build && node dist/doctor.js",
    "prepare": "npm run build",
    "test": "npm run build && tsx test/smoke.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
